generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model Business {
  id         String    @id @default(uuid())
  name       String
  inviteCode String    @unique @default(uuid())
  users      User[]
  products   Product[]
  createdAt  DateTime  @default(now())
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  role          Role     @default(EDITOR)
  emailVerified Boolean  @default(false)
  business      Business @relation(fields: [businessId], references: [id])
  businessId    String
  tokens        Token[]
  createdAt     DateTime @default(now())
}

model Product {
  id             String         @id @default(uuid())
  name           String
  price          Float
  unitPrice      Float?
  business       Business       @relation(fields: [businessId], references: [id])
  businessId     String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  priceHistories PriceHistory[]
}

model PriceHistory {
  id        String   @id @default(uuid())
  price     Float
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  createdAt DateTime @default(now())
}

model Token {
  id        String    @id @default(uuid())
  token     String    @unique
  type      TokenType
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime  @default(now())
}
